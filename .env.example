# Copy this file to `.env` and fill in the values. `.env` is gitignored — never commit it.

# --- Figma ---
# Personal access token. Scopes: file_content:read, file_metadata:read, file_versions:read, webhooks:write
FIGMA_TOKEN=figd_your_token_here

# The file to watch (the key in the Figma URL: figma.com/design/<KEY>/...)
FIGMA_FILE_KEY=d8VcZ6Nyf7KvdWa7UClLcz

# 노드↔파일 매핑은 server/figma-map.json (npm run webhook:map 으로 생성)

# --- Webhook receiver ---
# Public HTTPS URL from ngrok, no trailing slash
PUBLIC_URL=https://sharper-senator-crazed.ngrok-free.dev

# Shared secret: make up a long random string. Figma echoes it back on every event;
# the server rejects events whose passcode doesn't match.
WEBHOOK_PASSCODE=replace-with-a-random-string

# Local port the receiver listens on (ngrok forwards to this)
PORT=3000

# Wait this long after the LAST change before syncing. Keep it >= 5 min:
# Figma's MCP read cache holds the pre-save design for a few minutes, so a
# fast sync reads stale data and concludes "no change".
DEBOUNCE_MS=300000

# 1 = don't run Claude, just log what would happen. Set to 0 to actually sync.
DRY_RUN=1

# Extra args passed to `claude -p` when DRY_RUN=0
CLAUDE_ARGS=--permission-mode acceptEdits

# 이 파일을 `.env` 로 복사하고 값 채우기. `.env` 는 git 에 올리지 말 것.

# --- Figma ---
# Personal access token. 스코프: file_content:read, file_metadata:read, file_versions:read, webhooks:write
FIGMA_TOKEN=figd_여기에_토큰

# 감시할 파일 키 (figma.com/design/<KEY>/... 의 KEY)
FIGMA_FILE_KEY=

# --- Webhook 수신 서버 ---
# ngrok 공개 HTTPS 주소, 끝 슬래시 없이
PUBLIC_URL=https://your-domain.ngrok-free.dev

# Figma ↔ 서버 공유 비밀. 아무 긴 랜덤 문자열을 직접 지어냄
WEBHOOK_PASSCODE=

# 수신 포트 (ngrok 가 이 포트로 포워딩)
PORT=3000

# 마지막 변경 후 이만큼 기다렸다 sync. 5분 이상 권장
# (Figma MCP 읽기 캐시가 몇 분간 저장 전 디자인을 들고 있음 → 빠르면 stale 읽음)
DEBOUNCE_MS=300000

# 1 = 로그만, 0 = 실제 claude 실행. 배선 검증 전엔 1
DRY_RUN=1

# headless(`-p`) 실행은 권한 프롬프트에 답을 못 하므로 필요
CLAUDE_ARGS=--dangerously-skip-permissions
